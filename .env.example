# Copy this file to .env and set values for your local Redis instance.
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_COMMAND_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s

# Sample HTTP Basic user for local demonstration only.
DEMO_USERNAME=demo
DEMO_PASSWORD=change-this-local-demo-password
DEMO_API_KEY=change-this-local-demo-key

# Optional rate-limit settings. Defaults are 60 user tokens/minute and 120 API-key tokens/minute.
# RATE_LIMITER_API_KEY_HEADER=X-API-Key
# RATE_LIMITER_REDIS_KEY_PREFIX=rate-limit
